---
interface Props {
  eyebrow?: string;
  title: string;
  href?: string;
  hrefLabel?: string;
}
const { eyebrow, title, href, hrefLabel } = Astro.props;
---
<div class="mb-8 flex items-end justify-between gap-4">
  <div>
    {eyebrow && (
      <p class="mb-2 font-mono text-xs uppercase tracking-widest text-accent">{eyebrow}</p>
    )}
    <h2 class="text-2xl font-semibold sm:text-3xl">{title}</h2>
  </div>
  {href && (
    <a
      href={href}
      class="shrink-0 font-mono text-xs text-muted underline-offset-4 hover:text-accent hover:underline"
    >
      {hrefLabel ?? 'View all'} &rarr;
    </a>
  )}
</div>
