---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="Page not found.">
  <section class="py-16 text-center">
    <p class="font-mono text-6xl font-bold text-accent">404</p>
    <h1 class="mt-4 text-2xl font-semibold">This page wandered off.</h1>
    <p class="mt-3 text-muted">The link may be broken or the page may have moved.</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-fg transition-opacity hover:opacity-90"
    >
      Back home
    </a>
  </section>
</Base>
