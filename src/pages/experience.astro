---
import Base from '../layouts/Base.astro';
import { roles } from '../data/experience';

const featured = roles.filter((r) => r.featured);
const earlier = roles.filter((r) => !r.featured);
---
<Base title="Experience" description="Stefan Veleski's career timeline — from technical writer to configuration engineer at Veeam.">
  <header class="mb-12">
    <p class="font-mono text-xs uppercase tracking-widest text-accent">Experience</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">Career timeline</h1>
    <p class="mt-4 max-w-2xl text-muted">
      I moved from academia into technical writing at Veeam and climbed from junior to
      senior, then into docs engineering — automation, testing, and tooling.
    </p>
  </header>

  <ol class="relative space-y-10 border-l border-border pl-6">
    {featured.map((role) => (
      <li class="relative">
        <span
          class:list={[
            'absolute -left-[1.72rem] top-1.5 h-2.5 w-2.5 rounded-full ring-4 ring-bg',
            role.current ? 'bg-accent' : 'bg-faint',
          ]}
        ></span>
        <p class="font-mono text-xs text-faint">{role.period}</p>
        <h2 class="mt-1 text-lg font-semibold">
          {role.title} <span class="font-normal text-muted">· {role.org}</span>
        </h2>
        <p class="text-sm text-faint">{role.location}</p>
        <ul class="mt-3 space-y-1.5">
          {role.highlights.map((h) => (
            <li class="flex gap-2 text-sm leading-relaxed text-muted">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent"></span>
              <span>{h}</span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>

  <section class="mt-14">
    <h2 class="mb-5 font-mono text-xs uppercase tracking-widest text-faint">Earlier</h2>
    <ul class="space-y-4">
      {earlier.map((role) => (
        <li class="grid gap-1 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <p class="font-mono text-xs text-faint sm:pt-0.5">{role.period}</p>
          <div>
            <h3 class="text-sm font-medium">
              {role.title} <span class="text-muted">· {role.org}</span>
            </h3>
            {role.highlights[0] && (
              <p class="mt-1 text-sm leading-relaxed text-muted">{role.highlights[0]}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
