---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { publications } from '../data/publications';
import { talks } from '../data/talks';

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---
<Base title="Research" description="Peer-reviewed publications and conference talks from Stefan Veleski's digital-humanities research.">
  <header class="mb-12">
    <p class="font-mono text-xs uppercase tracking-widest text-accent">Research</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">Publications &amp; talks</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Before moving into industry I completed a PhD in the digital humanities, using
      computational text analysis to study why some novels endure. That work produced the
      peer-reviewed publications and conference talks below.
    </p>
  </header>

  <section>
    <h2 class="mb-6 font-mono text-xs uppercase tracking-widest text-faint">Publications</h2>
    <ol class="space-y-6">
      {publications.map((pub) => (
        <li class="grid gap-1 sm:grid-cols-[4rem_1fr] sm:gap-5">
          <p class="font-mono text-sm text-faint sm:pt-0.5">{pub.year}</p>
          <div>
            <h3 class="font-medium leading-snug">
              {pub.doi ? (
                <a
                  href={`https://doi.org/${pub.doi}`}
                  class="underline-offset-2 hover:text-accent hover:underline"
                  target="_blank"
                  rel="noopener"
                >{pub.title}</a>
              ) : (
                pub.title
              )}
            </h3>
            <p class="mt-1 text-sm text-muted">
              <span class="text-faint">{pub.type}</span> · {pub.venue}{pub.detail ? `, ${pub.detail}` : ''}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-14">
    <h2 class="mb-6 font-mono text-xs uppercase tracking-widest text-faint">Conference talks</h2>
    <ol class="space-y-6">
      {talks.map((talk) => (
        <li class="grid gap-1 sm:grid-cols-[4rem_1fr] sm:gap-5">
          <p class="font-mono text-xs text-faint sm:pt-1">{fmtDate(talk.date)}</p>
          <div>
            <h3 class="font-medium leading-snug">{talk.title}</h3>
            <p class="mt-1 text-sm text-muted">{talk.event} · {talk.location}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-14 rounded-lg border border-border bg-surface p-6">
    <p class="text-sm text-muted">
      Full publication and citation records are on Google Scholar and ORCID.
    </p>
    <SocialLinks class="mt-3" />
  </section>
</Base>
