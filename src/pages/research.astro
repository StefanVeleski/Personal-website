---
import Base from '../layouts/Base.astro';
import { publications } from '../data/publications';
import { talks } from '../data/talks';
import { researchThemes } from '../data/research-themes';
import { researchProfiles } from '../data/site';

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });

const isExternal = (href: string) => href.startsWith('http');
---
<Base title="Research" description="Peer-reviewed publications, conference talks, and research themes from Stefan Veleski's digital-humanities work.">
  <header class="mb-12">
    <p class="font-mono text-xs uppercase tracking-widest text-accent">Research</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">Publications &amp; talks</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Before moving into industry I completed a PhD in the digital humanities, using
      computational text analysis to study why some novels endure. That work produced the
      publications, talks, and research themes below.
    </p>
  </header>

  <!-- Research themes -->
  <section>
    <h2 class="mb-6 font-mono text-xs uppercase tracking-widest text-faint">Research themes</h2>
    <div class="grid gap-4 sm:grid-cols-3">
      {researchThemes.map((theme) => (
        <article class="flex flex-col rounded-lg border border-border bg-surface p-5">
          <h3 class="text-sm font-semibold leading-snug">{theme.title}</h3>
          <p class="mt-2 text-sm italic text-muted">{theme.question}</p>
          <p class="mt-3 flex-1 text-sm text-muted">{theme.body}</p>
          {theme.link && (
            <a
              href={theme.link.href}
              target="_blank"
              rel="noopener"
              class="mt-4 inline-flex items-center gap-1 font-mono text-xs text-accent hover:underline"
            >
              {theme.link.label} &rarr;
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Publications -->
  <section class="mt-16">
    <h2 class="mb-6 font-mono text-xs uppercase tracking-widest text-faint">Publications</h2>
    <ol class="space-y-8">
      {publications.map((pub, i) => (
        <li class="grid gap-1 sm:grid-cols-[4rem_1fr] sm:gap-5">
          <p class="font-mono text-sm text-faint sm:pt-0.5">{pub.year}</p>
          <div>
            <h3 class="font-medium leading-snug">
              {pub.links[0] ? (
                <a
                  href={pub.links[0].href}
                  class="underline-offset-2 hover:text-accent hover:underline"
                  target={isExternal(pub.links[0].href) ? '_blank' : undefined}
                  rel={isExternal(pub.links[0].href) ? 'noopener' : undefined}
                >{pub.title}</a>
              ) : (
                pub.title
              )}
            </h3>
            <p class="mt-1 text-sm text-muted">
              <span class="text-faint">{pub.type}</span> &middot; {pub.venue}
            </p>
            {pub.summary && <p class="mt-2 max-w-2xl text-sm text-muted">{pub.summary}</p>}
            <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5">
              {pub.links.map((link) => (
                <a
                  href={link.href}
                  target={isExternal(link.href) ? '_blank' : undefined}
                  rel={isExternal(link.href) ? 'noopener' : undefined}
                  class="font-mono text-xs text-muted transition-colors hover:text-accent"
                >{link.label}</a>
              ))}
              <details class="cite group">
                <summary class="cursor-pointer list-none font-mono text-xs text-muted transition-colors hover:text-accent">
                  Cite
                </summary>
                <div class="relative mt-2">
                  <button
                    type="button"
                    class="copy-cite absolute right-2 top-2 rounded border border-border bg-bg px-2 py-0.5 font-mono text-[0.65rem] text-muted transition-colors hover:text-accent"
                    data-cite={`cite-${i}`}
                  >Copy</button>
                  <pre id={`cite-${i}`} class="overflow-x-auto rounded-md border border-border bg-surface p-4 text-xs leading-relaxed"><code>{pub.cite}</code></pre>
                </div>
              </details>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Talks -->
  <section class="mt-16">
    <h2 class="mb-6 font-mono text-xs uppercase tracking-widest text-faint">Conference talks</h2>
    <ol class="space-y-8">
      {talks.map((talk) => (
        <li class="grid gap-1 sm:grid-cols-[4rem_1fr] sm:gap-5">
          <p class="font-mono text-xs text-faint sm:pt-1">{fmtDate(talk.date)}</p>
          <div>
            <h3 class="font-medium leading-snug">{talk.title}</h3>
            <p class="mt-1 text-sm text-muted">
              {talk.eventUrl ? (
                <a
                  href={talk.eventUrl}
                  target="_blank"
                  rel="noopener"
                  class="underline-offset-2 hover:text-accent hover:underline"
                >{talk.event}</a>
              ) : (
                talk.event
              )}
              {' '}&middot; {talk.location}
            </p>
            {talk.summary && <p class="mt-2 max-w-2xl text-sm text-muted">{talk.summary}</p>}
            {talk.links.length > 0 && (
              <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5">
                {talk.links.map((link) => (
                  <a
                    href={link.href}
                    target={isExternal(link.href) ? '_blank' : undefined}
                    rel={isExternal(link.href) ? 'noopener' : undefined}
                    class="font-mono text-xs text-muted transition-colors hover:text-accent"
                  >{link.label}</a>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-16 rounded-lg border border-border bg-surface p-6">
    <p class="text-sm text-muted">Full publication and citation records:</p>
    <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
      {researchProfiles.map((p) => (
        <li>
          <a
            href={p.href}
            target="_blank"
            rel="me noopener"
            class="font-mono text-sm text-accent hover:underline"
          >{p.label} &rarr;</a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-cite').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.cite;
      if (!id) return;
      const pre = document.getElementById(id);
      if (!pre) return;
      try {
        await navigator.clipboard.writeText(pre.innerText);
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => (btn.textContent = prev), 1500);
      } catch {
        /* clipboard unavailable — user can select manually */
      }
    });
  });
</script>
