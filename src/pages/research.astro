---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { publications } from '../data/publications';
import { talks } from '../data/talks';
import { researchThemes } from '../data/research-themes';
import { researchProfiles } from '../data/site';

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });

const isExternal = (href: string) => href.startsWith('http');

const linkClass =
  'inline-flex items-center gap-1 font-mono text-xs text-accent underline decoration-border underline-offset-4 transition-colors hover:decoration-accent';
---
<Base title="Research" description="Peer-reviewed publications, conference talks, and research themes from Stefan Veleski's digital-humanities work.">
  <header class="mb-12">
    <p class="font-mono text-xs uppercase tracking-widest text-accent">Research</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">Publications &amp; talks</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Before moving into industry I completed a PhD in the digital humanities, using
      computational text analysis to study why some novels endure. That work produced the
      publications, talks, and research themes below.
    </p>
  </header>

  <!-- Research themes -->
  <section>
    <h2 class="mb-6 font-mono text-xs uppercase tracking-widest text-faint">Research themes</h2>
    <ul class="space-y-8">
      {researchThemes.map((theme) => (
        <li class="border-l-2 border-border pl-5">
          <h3 class="font-semibold leading-snug">{theme.title}</h3>
          <p class="mt-2 text-sm italic text-muted">{theme.question}</p>
          <p class="mt-3 max-w-2xl text-sm text-muted">{theme.body}</p>
          {theme.link && (
            <a
              href={theme.link.href}
              target="_blank"
              rel="noopener"
              class={`mt-3 ${linkClass}`}
            >
              {theme.link.label}
              <Icon name="external" size={11} />
              <span class="sr-only">(opens in new tab)</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <!-- Publications -->
  <section class="mt-16">
    <h2 class="mb-6 font-mono text-xs uppercase tracking-widest text-faint">Publications</h2>
    <ol class="space-y-8">
      {publications.map((pub, i) => (
        <li class="grid gap-1 sm:grid-cols-[5rem_1fr] sm:gap-5">
          <p class="font-mono text-xs text-faint sm:pt-1">{pub.year}</p>
          <div>
            <h3 class="font-medium leading-snug">
              {pub.links[0] ? (
                <a
                  href={pub.links[0].href}
                  class="underline-offset-2 hover:text-accent hover:underline"
                  target={isExternal(pub.links[0].href) ? '_blank' : undefined}
                  rel={isExternal(pub.links[0].href) ? 'noopener' : undefined}
                >{pub.title}{isExternal(pub.links[0].href) && <span class="sr-only"> (opens in new tab)</span>}</a>
              ) : (
                pub.title
              )}
            </h3>
            <p class="mt-1 text-sm text-muted">
              <span class="text-faint">{pub.type}</span> &middot; {pub.venue}
            </p>
            {pub.summary && <p class="mt-2 max-w-2xl text-sm text-muted">{pub.summary}</p>}
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5">
              {pub.links.map((link) => (
                <a
                  href={link.href}
                  target={isExternal(link.href) ? '_blank' : undefined}
                  rel={isExternal(link.href) ? 'noopener' : undefined}
                  class={linkClass}
                >
                  {link.label}
                  {isExternal(link.href) && (
                    <>
                      <Icon name="external" size={11} />
                      <span class="sr-only">(opens in new tab)</span>
                    </>
                  )}
                </a>
              ))}
              <button
                type="button"
                class="cite-toggle font-mono text-xs text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
                aria-expanded="false"
                aria-controls={`cite-panel-${i}`}
              >Cite</button>
            </div>
            <div id={`cite-panel-${i}`} class="mt-3 overflow-hidden rounded-md border border-border bg-surface" hidden>
              <div class="flex items-center justify-between border-b border-border px-3 py-1.5">
                <span class="font-mono text-[0.65rem] uppercase tracking-widest text-faint">BibTeX</span>
                <button
                  type="button"
                  class="copy-cite rounded border border-border bg-bg px-2 py-0.5 font-mono text-[0.65rem] text-muted transition-colors hover:text-accent"
                  data-cite={`cite-${i}`}
                >Copy</button>
              </div>
              <pre id={`cite-${i}`} class="overflow-x-auto p-4 text-xs leading-relaxed"><code>{pub.cite}</code></pre>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Talks -->
  <section class="mt-16">
    <h2 class="mb-6 font-mono text-xs uppercase tracking-widest text-faint">Conference talks</h2>
    <ol class="space-y-8">
      {talks.map((talk) => (
        <li class="grid gap-1 sm:grid-cols-[5rem_1fr] sm:gap-5">
          <p class="font-mono text-xs text-faint sm:pt-1">{fmtDate(talk.date)}</p>
          <div>
            <h3 class="font-medium leading-snug">{talk.title}</h3>
            <p class="mt-1 text-sm text-muted">
              {talk.eventUrl ? (
                <a
                  href={talk.eventUrl}
                  target="_blank"
                  rel="noopener"
                  class="underline-offset-2 hover:text-accent hover:underline"
                >{talk.event}<span class="sr-only"> (opens in new tab)</span></a>
              ) : (
                talk.event
              )}
              {' '}&middot; {talk.location}
            </p>
            {talk.summary && <p class="mt-2 max-w-2xl text-sm text-muted">{talk.summary}</p>}
            {talk.links.length > 0 && (
              <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5">
                {talk.links.map((link) => (
                  <a
                    href={link.href}
                    target={isExternal(link.href) ? '_blank' : undefined}
                    rel={isExternal(link.href) ? 'noopener' : undefined}
                    class={linkClass}
                  >
                    {link.label}
                    {isExternal(link.href) && (
                      <>
                        <Icon name="external" size={11} />
                        <span class="sr-only">(opens in new tab)</span>
                      </>
                    )}
                  </a>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-16 rounded-lg border border-border bg-surface p-6">
    <p class="text-sm text-muted">Full publication and citation records:</p>
    <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
      {researchProfiles.map((p) => (
        <li>
          <a
            href={p.href}
            target="_blank"
            rel="me noopener"
            class="inline-flex items-center gap-1 font-mono text-sm text-accent underline decoration-border underline-offset-4 transition-colors hover:decoration-accent"
          >
            {p.label}
            <Icon name="external" size={11} />
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <p id="cite-status" class="sr-only" role="status" aria-live="polite"></p>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cite-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (!panel) return;
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  });

  const status = document.getElementById('cite-status');
  const announce = (msg: string) => {
    if (!status) return;
    status.textContent = '';
    setTimeout(() => (status.textContent = msg), 50);
  };

  document.querySelectorAll<HTMLButtonElement>('.copy-cite').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const pre = document.getElementById(btn.dataset.cite ?? '');
      if (!pre) return;
      let label = 'Copied';
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
      } catch {
        label = 'Copy failed';
      }
      btn.textContent = label;
      announce(label === 'Copied' ? 'BibTeX copied to clipboard' : 'Copy failed');
      setTimeout(() => (btn.textContent = 'Copy'), 1500);
    });
  });
</script>
